# ===========================================
# APSchool Production Environment Variables
# ===========================================
# -------------------------------------------
# Database (RDS PostgreSQL)
# -------------------------------------------
APSCHOOL_DB_HOST=your-rds-endpoint.us-east-1.rds.amazonaws.com
APSCHOOL_DB_PORT=5432
APSCHOOL_DB_DATABASE=apschool
APSCHOOL_DB_USERNAME=postgres
APSCHOOL_DB_PASSWORD=SECURE_PASSWORD_HERE
APSCHOOL_DB_SCHEMA=public
APSCHOOL_DB_SSLMODE=require
# -------------------------------------------
# Server
# -------------------------------------------
PORT=8080
JWT_SECRET=GENERATE_WITH_openssl_rand_-base64_32
# -------------------------------------------
# GitHub OAuth
# -------------------------------------------
# Create a new OAuth App with production URLs:
# https://github.com/settings/developers
GITHUB_CLIENT_ID=your_production_client_id
GITHUB_CLIENT_SECRET=your_production_client_secret
GITHUB_REDIRECT_URI=https://your-cloudfront-id.cloudfront.net/api/auth/github/callback
# -------------------------------------------
# Frontend
# -------------------------------------------
FRONTEND_URL=https://your-cloudfront-id.cloudfront.net
