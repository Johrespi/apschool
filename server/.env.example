# ===========================================
# APSchool Server Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# -------------------------------------------
# Database Configuration (PostgreSQL)
# -------------------------------------------
APSCHOOL_DB_HOST=localhost
APSCHOOL_DB_PORT=5432
APSCHOOL_DB_DATABASE=apschool
APSCHOOL_DB_USERNAME=postgres
APSCHOOL_DB_PASSWORD=your_password_here
APSCHOOL_DB_SCHEMA=public

# Database URL (for Goose migrations)
# Note: This should match the values above
DATABASE_URL=postgres://postgres:your_password_here@localhost:5432/apschool?sslmode=disable&search_path=public

# -------------------------------------------
# Server Configuration
# -------------------------------------------
PORT=8080

# -------------------------------------------
# JWT Authentication
# -------------------------------------------
# Generate a secure secret: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here

# -------------------------------------------
# GitHub OAuth
# -------------------------------------------
# Create an OAuth App at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_REDIRECT_URI=http://localhost:8080/api/auth/github/callback

# -------------------------------------------
# Frontend Configuration
# -------------------------------------------
FRONTEND_URL=http://localhost:4200
